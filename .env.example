# ==============================================================================
# Modus Light — Environment Configuration Template
# ==============================================================================
# Modus Light has zero runtime dependencies and deliberately does NOT auto-load
# a .env file. Export these yourself, or have your process manager / container
# runtime inject them:
#
#   set -a && . ./.env && set +a      # bash/zsh
#   env $(grep -v '^#' .env | xargs) modus-light demo
#
# Never commit a populated .env or production credentials to git.

# ------------------------------------------------------------------------------
# Read by the runtime (src/modus_light/client.py)
# ------------------------------------------------------------------------------

# Tenant label stamped onto every task tuple. Default: default_enterprise
MODUS_TENANT_ID=default_enterprise

# Step 5 pre-dispatch spend ceiling, in tokens. Default: 50000
# Must be an integer — a malformed value raises ConfigurationError at startup
# rather than silently falling back to the default ceiling.
MODUS_SPEND_CAP_TOKENS=50000

# ------------------------------------------------------------------------------
# Your own application's keys — Modus Light never reads or transmits these
# ------------------------------------------------------------------------------
# The community runtime executes entirely in-process and opens no sockets.
# These are here only as a convention for the code you place in front of it.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
